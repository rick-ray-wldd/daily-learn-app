# Echo — 環境變數（全部選填）
# 複製成 .env 後填值；改完記得重啟 dev server（npx expo start -c）。
# EXPO_PUBLIC_ 前綴是 Expo 的規定：只有這個前綴的變數會被打包進 client bundle。
#
# ⚠️ 安全注意：EXPO_PUBLIC_* 會進 JS bundle，拿到 app 的人就拿得到 key。
#    現在是 founder 自用 dogfood 階段所以可接受；W3 要把 Whisper / Claude
#    呼叫移到 Supabase Edge Functions（server-side key），client 不再帶 key。

# --- Supabase（選填）：不設也能跑（本地模式，資料只存手機） ---
# Supabase 專案 URL，例如 https://abcdefghijkl.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — 這是可公開的 client key，不是 service_role
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- OpenAI（選填）：Whisper 逐字稿 ---
# 不設 → 練習卡顯示「逐字稿待轉錄」，其餘流程照常。
# 設了 → 每集自動轉錄一次並快取（成本約 $0.006/分鐘，25 分鐘一集 ≈ $0.15；
#        音檔 >25MB 會直接放棄並顯示原因——Whisper 上限，Expo Go 沒 ffmpeg 切不了檔）。
EXPO_PUBLIC_OPENAI_API_KEY=

# --- Anthropic（選填）：Claude 難點診斷 ---
# 不設 → 練習卡略過診斷，其餘流程照常。
# 設了 → 顯示逐字稿時自動診斷該句（六類難點 + 中文解釋），單次遠低於 $0.01。
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# 診斷用的模型（選填，預設 claude-haiku-4-5-20251001：快又便宜）
EXPO_PUBLIC_DIAGNOSE_MODEL=
